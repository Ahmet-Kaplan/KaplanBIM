# Authentik — .env şablonu
#
# Kullanım: bu dosyayı `deploy/auth/.env` olarak kopyalayın ve gerçek
# değerleri doldurun. `.env` git tarafından izlenmez (kök .gitignore'da
# `.env` ve `.env.*` hariç tutulmuştur) — gerçek sırları ASLA commit etmeyin.
#
#   cp deploy/auth/.env.example deploy/auth/.env
#
# Sır üretimi (ayrıntılar için deploy/auth/README.md):
#   PASS="$(openssl rand -base64 24)"
#   echo "AUTHENTIK_SECRET_KEY=$(openssl rand -hex 32)" >> deploy/auth/.env
#   echo "POSTGRES_PASSWORD=$PASS"                     >> deploy/auth/.env
#
# docker-compose.yml bu dosyayı aynı dizinde otomatik okur
# (`docker compose -f deploy/auth/docker-compose.yml ...` komutu, compose
# dosyasının yanındaki .env'e bakar).

# ── Zorunlu sırlar (varsayılanı yok, boşsa compose başlamaz) ───────────────
# CHANGE_ME: aşağıdakileri doldurun. Boş bırakılırsa compose başlamayı reddeder
# (docker-compose.yml'deki zorunlu-değişken kalkanı) — bu kasıtlıdır; örnek
# bir değer bırakmak bu kalkanı etkisiz kılar.

# Authentik'in kendi imzalama/şifreleme sırrı. Üretim: `openssl rand -hex 32`.
AUTHENTIK_SECRET_KEY=

# Tek Postgres şifresi. Hem postgresql konteyneri hem de Authentik
# (server + worker, AUTHENTIK_POSTGRESQL__PASSWORD olarak) bu TEK değeri okur.
POSTGRES_PASSWORD=

# ── Hata raporlama ──────────────────────────────────────────────────────────
# Sentry'e otomatik hata raporlamayı kapatır (varsayılan zaten false; firma
# verisi içeren kurulumlarda kapalı kalması önerilir).
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ── Opsiyonel (varsayılanları var) ──────────────────────────────────────────
# AUTHENTIK_POSTGRESQL__USER=authentik
# AUTHENTIK_POSTGRESQL__NAME=authentik
# COMPOSE_PORT_HTTP=9000
# COMPOSE_PORT_HTTPS=9443
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# AUTHENTIK_TAG=2026.8.5
