# OpenConstructionERP — üretim .env şablonu
#
# Kullanım: bu dosyayı `deploy/erp/.env` olarak kopyalayın ve gerçek
# değerleri doldurun. `.env` git tarafından izlenmez (kök .gitignore'da
# `.env` ve `.env.*` hariç tutulmuştur) — gerçek sırları ASLA commit etmeyin.
#
#   cp deploy/erp/.env.example deploy/erp/.env
#
# Sır üretimi (ayrıntılar için ../README.md § "Sır üretimi"):
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 24)" >> deploy/erp/.env
#   echo "JWT_SECRET=$(openssl rand -hex 32)"           >> deploy/erp/.env
#
# docker-compose.prod.yml bu dosyayı aynı dizinde otomatik okur
# (`docker compose -f deploy/erp/docker-compose.prod.yml ...` komutu
# çalıştığı dizine göre değil, compose dosyasının yanındaki .env'e bakar).

# ── Zorunlu sırlar (varsayılanı yok, boşsa compose başlamaz) ───────────────
POSTGRES_PASSWORD=
JWT_SECRET=

# ── HTTPS (Caddy ters vekili için zorunlu) ─────────────────────────────────
# ERP'nin yayınlanacağı tam alan adı. Genel DNS üzerinden bu sunucuya
# çözülmelidir (Let's Encrypt doğrulaması için). Firma içi/DNS'siz kurulum
# için ../README.md § "Firma içi (genel DNS olmadan) HTTPS" bölümüne bakın.
DOMAIN=erp.ornekfirma.com.tr
# Let's Encrypt hesap bildirimleri için e-posta (opsiyonel ama önerilir).
ACME_EMAIL=

# ── Veritabanı (varsayılanları var) ─────────────────────────────────────────
# POSTGRES_USER=oe
# POSTGRES_DB=openestimate

# ── JWT (varsayılanları var) ────────────────────────────────────────────────
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# ── Uygulama ─────────────────────────────────────────────────────────────
# Tarayıcının gerçekten kullanacağı köken(ler); DOMAIN ile birebir uyuşmalı,
# yoksa API çağrıları tarayıcı tarafından sessizce reddedilir (boş ekran).
ALLOWED_ORIGINS=https://erp.ornekfirma.com.tr
LOG_LEVEL=INFO
# Üretimde demo hesap/proje tohumlaması kapalı. Yalnızca test amacıyla demo
# verisi görmek isterseniz geçici olarak "true" yapın, sonra "false"'a dönün.
SEED_DEMO=false

# ── Opsiyonel (ihtiyaç yoksa boş bırakın) ───────────────────────────────────
# REDIS_URL=redis://redis:6379/0
# OE_DATA_DIR=/data
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=openestimate
# AI/vektör arama için qdrant profilini açarsanız (docker compose --profile ai ...):
# QDRANT_URL=http://qdrant:6333
